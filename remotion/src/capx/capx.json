   "speech_s": 3.74,
   "leadFrames": 4,
   "speechFrames": 112,
   "startFrame": 3971,
   "durationInFrames": 127
  },
  {
   "id": "d3",
   "chapter": "THE DIAGNOSIS",
   "scene": "pipeline",
   "text": "Not one of them ever looks at the work.",
