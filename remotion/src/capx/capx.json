   "speech_s": 11.331,
   "leadFrames": 4,
   "speechFrames": 340,
   "startFrame": 3616,
   "durationInFrames": 355
  },
  {
   "id": "d2",
   "chapter": "THE DIAGNOSIS",
   "scene": "pipeline",
   "text": "Every hand-off is a different company, and every hand-off loses signal.",
