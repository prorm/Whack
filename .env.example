# Vertex AI (ADC or a service-account JSON). GCP_PROJECT is also accepted.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_MEDIA_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_APPLICATION_CREDENTIALS=google_credentials.json
# Gemini Developer API fallback (used only when GOOGLE_GENAI_USE_VERTEXAI=False)
GOOGLE_API_KEY=
# Hard kill-switch: cumulative spend across every run in reports/cost_log.jsonl
MAX_TEST_BUDGET_USD=5.00
# Safety toggle: Veo calls are refused unless this is true
ENABLE_LIVE_VIDEO_GEN=false

# Browser demo server only. A Vertex API key plus the Google Cloud project selects project-key mode.
# CAPABLE_VERTEX_AUTH=project-key
# CAPABLE_VERTEX_API_KEY=
# Gemini Decisions uses the Developer API. Supply a key allowed for generativelanguage.googleapis.com.
# CAPABLE_DECISIONS_API_KEY=
# Persistent app-specific ceiling. Values above $4.75 are clamped down.
CAPABLE_GEMINI_BUDGET_USD=4.75
# CAPABLE_GEMINI_ENABLED=0
