  "concept_id": "percentages",
  "graph_nodes": ["percent_basic", "commission_calc", "percent_change", "sheet_percent_formula"],
  "learning_objective": "Calculate a percent of a quantity, a commission, a percentage change, and write the matching spreadsheet formula.",
  "prerequisites": ["mult_div", "fractions_decimals"],
  "essential_facts": [
    "Percent means 'out of 100': 15% = 15/100 = 0.15.",
    "x% of N = N × x / 100.",
    "Commission at r% on sales S = S × r / 100; fixed per-order bonus is added separately.",
    "Percentage change = (new − old) / old × 100; the base is the OLD value.",
    "In a spreadsheet, if C2 holds 5 (meaning 5%), use =B2*C2/100; if C2 is formatted as 5%, use =B2*C2."
  ],
