{
  "name": "capable",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node ../scripts/capable_server.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:flux": "node --test \"src/flux/*.test.ts\" \"src/flux/learn/*.test.ts\"",
    "test:os": "node --test \"src/os/*.test.ts\"",
    "demo": "npm run build && node ../scripts/capable_server.mjs --port 4173 --data .data/demo.sqlite",
    "test:capable": "node --test ../scripts/capable_upgrade.test.mjs",
    "test:all": "npm run test:flux && npm run test:os && npm run test:capable"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
