{
  "name": "capable",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node ../scripts/capable_server.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:engine": "node --test \"src/engine/*.test.ts\"",
    "test:moonshot": "node --test \"src/moonshot/*.test.ts\"",
    "test:flux": "node --test \"src/flux/*.test.ts\" \"src/flux/learn/*.test.ts\"",
    "sim:bandit": "node src/engine/sim_bandit.ts",
    "demo": "npm run build && node ../scripts/capable_server.mjs --port 4173 --data .data/demo.sqlite",
    "test:all": "npm run test:flux && npm run test:engine && npm run test:moonshot"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
